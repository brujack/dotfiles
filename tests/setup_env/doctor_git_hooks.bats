#!/usr/bin/env bats
# _doctor_check_git_hooks: does each listed repo carry its own, runnable hooks?

load '../helpers/common.bash'

setup() {
  load_setup_env
  # shellcheck disable=SC1091
  source "${REPO_ROOT}/lib/git_hooks.sh"

  export GIT_AUTHOR_NAME="bats" GIT_AUTHOR_EMAIL="bats@example.com"
  export GIT_COMMITTER_NAME="bats" GIT_COMMITTER_EMAIL="bats@example.com"
  # A real core.hooksPath pin on the developer's box must not leak into the
  # fixtures (it would trip the R27 precondition in every test).
  : > "${BATS_TEST_TMPDIR}/gitconfig-global"
  : > "${BATS_TEST_TMPDIR}/gitconfig-system"
  export GIT_CONFIG_GLOBAL="${BATS_TEST_TMPDIR}/gitconfig-global"
  export GIT_CONFIG_SYSTEM="${BATS_TEST_TMPDIR}/gitconfig-system"

  export PERSONAL_GITREPOS="${BATS_TEST_TMPDIR}/personal"
  mkdir -p "${PERSONAL_GITREPOS}"
  OUT="${BATS_TEST_TMPDIR}/arm_out"
}

# make_repo <name> [with_precommit] -- a fixture repo on master tracking an
# install-hooks Makefile and the mandated hook sources, with byte-copies
# installed and executable. Without "with_precommit" it tracks no pre-commit
# source and does track .pre-commit-config.yaml (like state-ledger).
make_repo() {
  local _d="${PERSONAL_GITREPOS}/$1"
  git init -q -b master "${_d}"
  mkdir -p "${_d}/scripts"
  printf 'install-hooks:\n\t@true\n' > "${_d}/Makefile"
  printf '#!/bin/sh\necho push\n' > "${_d}/scripts/pre-push"
  printf '#!/bin/sh\necho msg\n' > "${_d}/scripts/commit-msg"
  if [[ "${2:-}" == "with_precommit" ]]; then
    printf '#!/bin/sh\necho commit\n' > "${_d}/scripts/pre-commit-hook.sh"
  else
    printf 'repos: []\n' > "${_d}/.pre-commit-config.yaml"
  fi
  # Executable, as real hook sources are: a symlinked hook is only -x when its
  # target is.
  chmod +x "${_d}/scripts/"*
  git -C "${_d}" add -A
  git -C "${_d}" commit -q -m init
  cp "${_d}/scripts/pre-push" "${_d}/.git/hooks/pre-push"
  cp "${_d}/scripts/commit-msg" "${_d}/.git/hooks/commit-msg"
  if [[ "${2:-}" == "with_precommit" ]]; then
    cp "${_d}/scripts/pre-commit-hook.sh" "${_d}/.git/hooks/pre-commit"
  else
    # The shim a pre-commit-managed repo carries, with an interpreter that works.
    make_py "${BATS_TEST_TMPDIR}/py-good" 0
    write_shim "${_d}/.git/hooks/pre-commit" "'${BATS_TEST_TMPDIR}/py-good'" pre-commit
  fi
  chmod +x "${_d}/.git/hooks/"*
}

# make_py <path> <rc> [sleep] -- a stub interpreter answering only the probe argv.
make_py() {
  mkdir -p "$(dirname "$1")"
  {
    printf '#!/bin/bash\n'
    printf 'if [[ "$1" != "-I" || "$2" != "-c" || "$3" != "import pre_commit" ]]; then exit 99; fi\n'
    [[ -n "${3:-}" ]] && printf 'sleep %s\n' "$3"
    printf 'exit %s\n' "$2"
  } > "$1"
  chmod +x "$1"
}

# write_shim <path> <INSTALL_PYTHON value, verbatim> <hook type>
write_shim() {
  {
    printf '#!/usr/bin/env bash\n'
    printf '# File generated by pre-commit: https://pre-commit.com\n'
    printf '# ID: 138fd403232d2ddd5efb44317e38bf03\n'
    printf '# start templated\n'
    printf 'INSTALL_PYTHON=%s\n' "$2"
    printf 'ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=%s)\n' "$3"
    printf '# end templated\n'
    printf 'exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"\n'
  } > "$1"
  chmod +x "$1"
}

# run_arm -- NOT `run`: a subshell would lose the counters. Output goes to a file.
run_arm() {
  _DOCTOR_PASS=0; _DOCTOR_FAIL=0; _DOCTOR_WARN=0; _DOCTOR_FAILED=0
  _doctor_check_git_hooks > "${OUT}" 2>&1
}

@test "doctor git hooks: a healthy repo reports one PASS line" {
  make_repo alpha with_precommit
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "Git hooks:" "${OUT}"
  grep -qF "alpha: pre-commit pre-push commit-msg installed" "${OUT}"
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_WARN}" -eq 0 ]
}

@test "doctor git hooks: symlinked hooks to the tracked sources pass" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  rm "${_d}/.git/hooks/pre-push"
  ln -s ../../scripts/pre-push "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: a pre-commit shim that can run is a PASS" {
  make_repo beta
  HOOK_EXPECTED_REPOS=(beta)
  run_arm
  grep -qF "beta: pre-commit pre-push commit-msg installed" "${OUT}"
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: an absent repo prints an info line and moves no counter" {
  make_repo alpha with_precommit
  HOOK_EXPECTED_REPOS=(ghost alpha)
  run_arm
  grep -qxF "  - ghost: not cloned on this host" "${OUT}"
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_WARN}" -eq 0 ]
}

@test "doctor git hooks: no listed repo found is one FAIL naming PERSONAL_GITREPOS" {
  HOOK_EXPECTED_REPOS=(ghost phantom)
  run_arm
  grep -qxF "  - ghost: not cloned on this host" "${OUT}"
  grep -qxF "  - phantom: not cloned on this host" "${OUT}"
  grep -qF "git hooks: no listed repo found under ${PERSONAL_GITREPOS} — check GITREPOS" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: an empty HOOK_EXPECTED_REPOS is one FAIL and checks nothing" {
  make_repo alpha with_precommit
  HOOK_EXPECTED_REPOS=()
  run_arm
  grep -qF "git hooks: HOOK_EXPECTED_REPOS is empty — config/hook_repos.sh missing or empty" "${OUT}"
  [ "$(command grep -cF "alpha" "${OUT}")" -eq 0 ]
  [ "${_DOCTOR_FAIL}" -eq 1 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: a pinned core.hooksPath is one WARN and checks no repo" {
  make_repo alpha with_precommit
  printf '[core]\n\thooksPath = /tmp/mine\n' > "${GIT_CONFIG_GLOBAL}"
  HOOK_EXPECTED_REPOS=(alpha ghost)
  run_arm
  grep -qF "git hooks: skipped: core.hooksPath is pinned (see Git hooksPath above)" "${OUT}"
  [ "$(command grep -cF "alpha" "${OUT}")" -eq 0 ]
  [ "$(command grep -cF "ghost" "${OUT}")" -eq 0 ]
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: a .git file prints nothing" {
  make_repo alpha with_precommit
  mkdir -p "${PERSONAL_GITREPOS}/wtlike"
  printf 'gitdir: /nonexistent\n' > "${PERSONAL_GITREPOS}/wtlike/.git"
  HOOK_EXPECTED_REPOS=(wtlike alpha)
  run_arm
  [ "$(command grep -cF "wtlike" "${OUT}")" -eq 0 ]
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_WARN}" -eq 0 ]
}

@test "doctor git hooks: a .git directory git cannot use is a FAIL" {
  make_repo alpha with_precommit
  mkdir -p "${PERSONAL_GITREPOS}/partial/.git"
  HOOK_EXPECTED_REPOS=(partial alpha)
  run_arm
  grep -qF "partial: cannot verify hooks (not a usable git repository)" "${OUT}"
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: missing hooks sharing one remedy name it once" {
  make_repo beta
  local _d="${PERSONAL_GITREPOS}/beta"
  rm "${_d}/.git/hooks/pre-commit" "${_d}/.git/hooks/pre-push" "${_d}/.git/hooks/commit-msg"
  HOOK_EXPECTED_REPOS=(beta)
  run_arm
  grep -qF "beta: missing pre-commit pre-push commit-msg — remedy: cd ${_d} && pre-commit install; make -C ${_d} install-hooks" "${OUT}"
  [ "$(command grep -cF "install-hooks; make" "${OUT}")" -eq 0 ]
  [ "$(command grep -cF "beta: missing" "${OUT}")" -eq 1 ]
}

@test "doctor git hooks: no hooks directory FAILs with the install-hooks remedy" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  rm -rf "${_d}/.git/hooks"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: no hooks directory — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: the remedy directory is the subdirectory holding install-hooks" {
  local _d="${PERSONAL_GITREPOS}/ansible-like"
  git init -q -b master "${_d}"
  mkdir -p "${_d}/ansible"
  printf 'install-hooks:\n\t@true\n' > "${_d}/ansible/Makefile"
  git -C "${_d}" add -A
  git -C "${_d}" commit -q -m init
  rm -rf "${_d}/.git/hooks"
  HOOK_EXPECTED_REPOS=(ansible-like)
  run_arm
  grep -qF "ansible-like: no hooks directory — remedy: make -C ${_d}/ansible install-hooks" "${OUT}"
}

@test "doctor git hooks: the remedy directory falls back to the repo when no target resolves" {
  local _d="${PERSONAL_GITREPOS}/bare"
  git init -q -b master "${_d}"
  git -C "${_d}" commit -q --allow-empty -m init
  rm -rf "${_d}/.git/hooks"
  HOOK_EXPECTED_REPOS=(bare)
  run_arm
  grep -qF "bare: no hooks directory — remedy: make -C ${_d} install-hooks" "${OUT}"
}

@test "doctor git hooks: one missing hook FAILs naming it" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  rm "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: missing pre-push — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: a non-executable hook counts as missing, listed space-joined" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  chmod -x "${_d}/.git/hooks/pre-push" "${_d}/.git/hooks/commit-msg"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: missing pre-push commit-msg — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: a missing pre-commit in a pre-commit-managed repo names pre-commit install" {
  make_repo beta
  local _d="${PERSONAL_GITREPOS}/beta"
  rm "${_d}/.git/hooks/pre-commit"
  HOOK_EXPECTED_REPOS=(beta)
  run_arm
  grep -qF "beta: missing pre-commit — remedy: cd ${_d} && pre-commit install" "${OUT}"
}

@test "doctor git hooks: a hook with a tracked source keeps the install-hooks remedy" {
  # beta tracks .pre-commit-config.yaml but also tracks scripts/pre-push, so
  # a missing pre-push is repaired by the Makefile, not by pre-commit.
  make_repo beta
  local _d="${PERSONAL_GITREPOS}/beta"
  rm "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(beta)
  run_arm
  grep -qF "beta: missing pre-push — remedy: make -C ${_d} install-hooks" "${OUT}"
}

@test "doctor git hooks: a stale hook on master is a FAIL" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push is stale — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
  [ "${_DOCTOR_WARN}" -eq 0 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: a stale hook on main is a FAIL" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  git -C "${_d}" branch -m main
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push is stale" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: a stale hook on a feature branch is a WARN naming the branch" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  git -C "${_d}" checkout -q -b feat/x
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push differs from feat/x (expected off the default branch)" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: a stale hook on a detached HEAD is a WARN saying so" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  git -C "${_d}" checkout -q --detach
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push differs from detached HEAD (expected off the default branch)" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: a symlink to another repo's script is foreign" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf '#!/bin/sh\necho elsewhere\n' > "${BATS_TEST_TMPDIR}/elsewhere"
  chmod +x "${BATS_TEST_TMPDIR}/elsewhere"
  rm "${_d}/.git/hooks/pre-push"
  ln -s "${BATS_TEST_TMPDIR}/elsewhere" "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push is not this repo's pre-push script — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: a symlink into a linked worktree is a WARN naming it" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  git -C "${_d}" worktree add -q "${BATS_TEST_TMPDIR}/wt" -b wtbranch
  rm "${_d}/.git/hooks/pre-push"
  ln -s "${BATS_TEST_TMPDIR}/wt/scripts/pre-push" "${_d}/.git/hooks/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  local _wt
  _wt="$(cd -P "${BATS_TEST_TMPDIR}/wt" && pwd -P)"
  grep -qF "alpha: pre-push runs from worktree ${_wt}/scripts/pre-push — remedy: make -C ${_d} install-hooks" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: a shim whose interpreter is missing is a FAIL with pre-commit install" {
  make_repo beta
  local _d="${PERSONAL_GITREPOS}/beta"
  write_shim "${_d}/.git/hooks/pre-commit" "'/nonexistent/py'" pre-commit
  HOOK_EXPECTED_REPOS=(beta)
  run_arm
  grep -qF "beta: pre-commit is a pre-commit shim that cannot run here (INSTALL_PYTHON /nonexistent/py missing) — remedy: cd ${_d} && pre-commit install" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
}

@test "doctor git hooks: a shim probe that times out is a WARN" {
  make_repo beta
  local _d="${PERSONAL_GITREPOS}/beta"
  make_py "${BATS_TEST_TMPDIR}/py-slow" 0 5
  write_shim "${_d}/.git/hooks/pre-commit" "'${BATS_TEST_TMPDIR}/py-slow'" pre-commit
  HOOK_EXPECTED_REPOS=(beta)
  _DOCTOR_PROBE_TIMEOUT=1 run_arm
  grep -qF "beta: pre-commit pre-commit shim not verified (probe timed out)" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: an unreadable identity is a FAIL per hook" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf 'garbage' > "${_d}/.git/index"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: cannot verify hooks (" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 3 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: one-byte edit of an installed copy turns PASS into a stale FAIL" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-commit pre-push commit-msg installed" "${OUT}"
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  run_arm
  grep -qF "alpha: pre-push is stale" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 1 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: each faulty hook gets its own line" {
  make_repo alpha with_precommit
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf 'x' >> "${_d}/.git/hooks/pre-push"
  printf 'x' >> "${_d}/.git/hooks/commit-msg"
  # shellcheck disable=SC2034 # read by _doctor_check_git_hooks (lib/helpers.sh) through run_arm
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push is stale" "${OUT}"
  grep -qF "alpha: commit-msg is stale" "${OUT}"
  [ "${_DOCTOR_FAIL}" -eq 2 ]
}

@test "doctor git hooks: run_doctor calls the arm on the line after _doctor_check_hooks_path" {
  local _src="${BATS_TEST_DIRNAME}/../../lib/helpers.sh"
  local _body _prev_line _hp_line
  _body="$(declare -f run_doctor | sed 's/^ *//')"
  _hp_line="$(printf '%s\n' "${_body}" | grep -n '^_doctor_check_hooks_path;$' | head -1 | cut -d: -f1)"
  [ -n "${_hp_line}" ]
  [ "$(printf '%s\n' "${_body}" | sed -n "$(( _hp_line + 1 ))p")" = "_doctor_check_git_hooks;" ]
  # The source carries the same adjacency.
  _prev_line="$(grep -n '^  _doctor_check_hooks_path$' "${_src}" | head -1 | cut -d: -f1)"
  [ -n "${_prev_line}" ]
  [ "$(sed -n "$(( _prev_line + 1 ))p" "${_src}")" = "  _doctor_check_git_hooks" ]
}

# make_symlinked_repo <name> [branch] -- make_repo, then every mandated hook is
# a symlink into the repo's own scripts/ (how a symlink-installed checkout looks).
make_symlinked_repo() {
  local _d="${PERSONAL_GITREPOS}/$1" _h
  make_repo "$1" with_precommit
  if [[ -n "${2:-}" && "$2" != master ]]; then
    git -C "${_d}" branch -m "$2"
  fi
  for _h in pre-push commit-msg; do
    rm "${_d}/.git/hooks/${_h}"
    ln -s "../../scripts/${_h}" "${_d}/.git/hooks/${_h}"
  done
  rm "${_d}/.git/hooks/pre-commit"
  ln -s ../../scripts/pre-commit-hook.sh "${_d}/.git/hooks/pre-commit"
}

@test "doctor git hooks: a symlinked hook that drifts on master warns with the inspect-then-clean remedy" {
  make_symlinked_repo alpha master
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf '# edit\n' >> "${_d}/scripts/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push drifts: scripts/pre-push differs from master — remedy: inspect with git -C ${_d} diff master -- scripts/pre-push, then return ${_d} to a clean master once no session owns the change" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
  [ "${_DOCTOR_PASS}" -eq 0 ]
}

@test "doctor git hooks: a symlinked hook that drifts on main names main in the remedy" {
  make_symlinked_repo alpha main
  local _d="${PERSONAL_GITREPOS}/alpha"
  printf '# edit\n' >> "${_d}/scripts/pre-push"
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-push drifts: scripts/pre-push differs from main — remedy: inspect with git -C ${_d} diff main -- scripts/pre-push, then return ${_d} to a clean main once no session owns the change" "${OUT}"
  [ "${_DOCTOR_WARN}" -eq 1 ]
  [ "${_DOCTOR_FAIL}" -eq 0 ]
}

@test "doctor git hooks: a clean symlinked repo passes with no drift line" {
  make_symlinked_repo alpha master
  # shellcheck disable=SC2034 # read by _doctor_check_git_hooks (lib/helpers.sh) through run_arm
  HOOK_EXPECTED_REPOS=(alpha)
  run_arm
  grep -qF "alpha: pre-commit pre-push commit-msg installed" "${OUT}"
  if grep -qF "drifts:" "${OUT}"; then return 1; fi
  [ "${_DOCTOR_PASS}" -eq 1 ]
  [ "${_DOCTOR_WARN}" -eq 0 ]
}
