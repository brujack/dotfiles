#!/usr/bin/env bats
# _git_hooks_identity: does an installed hook belong to its repo?

load '../helpers/common.bash'

setup() {
  load_setup_env
  # shellcheck disable=SC1091
  source "${REPO_ROOT}/lib/git_hooks.sh"

  export GIT_AUTHOR_NAME="bats" GIT_AUTHOR_EMAIL="bats@example.com"
  export GIT_COMMITTER_NAME="bats" GIT_COMMITTER_EMAIL="bats@example.com"
  # A real pin on the developer's box must not leak into fixture repos.
  : > "${BATS_TEST_TMPDIR}/gitconfig-global"
  : > "${BATS_TEST_TMPDIR}/gitconfig-system"
  export GIT_CONFIG_GLOBAL="${BATS_TEST_TMPDIR}/gitconfig-global"
  export GIT_CONFIG_SYSTEM="${BATS_TEST_TMPDIR}/gitconfig-system"

  TESTDIR="${BATS_TEST_TMPDIR}"
  REPO="${TESTDIR}/repo"
  HK="${REPO}/.git/hooks"
  TAB=$'\t'
}

# make_repo [with_precommit] -- a fixture repo tracking the three mandated
# hook sources, each with distinct bytes. Without "with_precommit" it tracks no
# pre-commit source (like state-ledger, whose pre-commit comes from pre-commit
# itself) and does track .pre-commit-config.yaml.
make_repo() {
  git init -q -b master "${REPO}"
  mkdir -p "${REPO}/scripts"
  printf '#!/bin/sh\necho push\n' > "${REPO}/scripts/pre-push"
  printf '#!/bin/sh\necho msg\n' > "${REPO}/scripts/commit-msg"
  printf 'repos: []\n' > "${REPO}/.pre-commit-config.yaml"
  if [[ "${1:-}" == "with_precommit" ]]; then
    printf '#!/bin/sh\necho commit\n' > "${REPO}/scripts/pre-commit-hook.sh"
  fi
  git -C "${REPO}" add -A
  git -C "${REPO}" commit -q -m init
}

# make_py <path> <rc> [sleep] -- a stub interpreter. It answers only the exact
# probe argv (-I -c 'import pre_commit'); anything else exits 99, so a probe
# that drops -I is visible.
make_py() {
  mkdir -p "$(dirname "$1")"
  {
    printf '#!/bin/bash\n'
    printf 'if [[ "$1" != "-I" || "$2" != "-c" || "$3" != "import pre_commit" ]]; then exit 99; fi\n'
    [[ -n "${3:-}" ]] && printf 'sleep %s\n' "$3"
    printf 'exit %s\n' "$2"
  } > "$1"
  chmod +x "$1"
}

# write_shim <path> <INSTALL_PYTHON line value, verbatim> <hook type>
write_shim() {
  {
    printf '#!/usr/bin/env bash\n'
    printf '# File generated by pre-commit: https://pre-commit.com\n'
    printf '# ID: 138fd403232d2ddd5efb44317e38bf03\n'
    printf '# start templated\n'
    printf 'INSTALL_PYTHON=%s\n' "$2"
    printf 'ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=%s)\n' "$3"
    printf '# end templated\n'
    printf 'HERE="$(cd "$(dirname "$0")" && pwd)"\n'
    printf 'ARGS+=(--hook-dir "$HERE" -- "$@")\n'
    printf 'exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"\n'
  } > "$1"
  chmod +x "$1"
}

# --- source-candidate identities ------------------------------------------

@test "identity: absolute symlink to the tracked source is match" {
  make_repo
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: symlink to a tracked candidate deleted from the working tree is stale" {
  make_repo
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  rm -- "${REPO}/scripts/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: relative symlink to the tracked source is match" {
  make_repo
  ln -s ../../scripts/pre-push "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: symlink through a symlinked repo path is still match" {
  make_repo
  ln -s "${REPO}" "${TESTDIR}/alias"
  ln -s "${TESTDIR}/alias/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${TESTDIR}/alias" pre-push "${TESTDIR}/alias/.git/hooks/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: byte copy of the tracked source is match" {
  make_repo
  cp "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: copy of <hook>-hook.sh is match for that hook name" {
  make_repo with_precommit
  cp "${REPO}/scripts/pre-commit-hook.sh" "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: one-byte edit turns a passing copy into stale" {
  make_repo
  cp "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
  printf 'x' >> "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: cross-hook swap (pre-commit holding pre-push bytes) is stale" {
  make_repo with_precommit
  cp "${REPO}/scripts/pre-push" "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: symlink swap (pre-commit linked to scripts/pre-push) is stale" {
  make_repo with_precommit
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: empty hook file is stale" {
  make_repo
  : > "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: symlink into a linked worktree is worktree" {
  make_repo
  git -C "${REPO}" worktree add -q "${TESTDIR}/wt" -b side
  ln -s "${TESTDIR}/wt/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "worktree" ]
}

@test "identity: symlink to another repo is foreign" {
  make_repo
  mkdir -p "${TESTDIR}/other"
  printf '#!/bin/sh\n' > "${TESTDIR}/other/pre-push"
  ln -s "${TESTDIR}/other/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "foreign" ]
}

@test "identity: symlink to an untracked file in the main tree is stale" {
  make_repo
  printf '#!/bin/sh\n' > "${REPO}/scripts/untracked"
  ln -s "${REPO}/scripts/untracked" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "identity: unreadable hook is rc 2 with a reason" {
  [[ "$(id -u)" -ne 0 ]] || skip "root reads mode-000 files"
  make_repo
  cp "${REPO}/scripts/pre-push" "${HK}/pre-push"
  chmod 000 "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  chmod 644 "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [[ "${output}" == "error${TAB}cannot read "* ]]
}

@test "identity: missing hook is rc 2 with a reason" {
  make_repo
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [[ "${output}" == "error${TAB}cannot read "* ]]
}

@test "identity: git ls-files failure is rc 2 with a reason" {
  mkdir -p "${TESTDIR}/notrepo"
  : > "${TESTDIR}/notrepo/hook"
  run _git_hooks_identity "${TESTDIR}/notrepo" pre-push "${TESTDIR}/notrepo/hook"
  [ "${status}" -eq 2 ]
  [ "${output}" = "error${TAB}git ls-files failed" ]
}

# --- generated (pre-commit shim) identities -------------------------------

@test "shim: probe rc 0 is generated" {
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "generated" ]
}

@test "shim: probe rc 1 is generated-broken cannot import" {
  make_repo
  make_py "${TESTDIR}/py/python" 1
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}${TESTDIR}/py/python cannot import pre_commit" ]
}

@test "shim: probe slower than _DOCTOR_PROBE_TIMEOUT is generated-unverified" {
  make_repo
  make_py "${TESTDIR}/py/python" 0 5
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  _DOCTOR_PROBE_TIMEOUT=1 run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-unverified${TAB}probe timed out" ]
}

@test "shim: no timeout binary is generated-unverified" {
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  _doctor_resolve_timeout() { return 0; }
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-unverified${TAB}no timeout binary" ]
}

@test "shim: missing interpreter is broken even with pre-commit on PATH" {
  make_repo
  mkdir -p "${TESTDIR}/bin"
  printf '#!/bin/sh\nexit 0\n' > "${TESTDIR}/bin/pre-commit"
  chmod +x "${TESTDIR}/bin/pre-commit"
  write_shim "${HK}/pre-commit" "${TESTDIR}/gone/python" pre-commit
  PATH="${TESTDIR}/bin:${PATH}" run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}INSTALL_PYTHON ${TESTDIR}/gone/python missing" ]
}

@test "shim: repo without .pre-commit-config.yaml is generated-broken" {
  make_repo
  git -C "${REPO}" rm -q .pre-commit-config.yaml
  git -C "${REPO}" commit -q -m drop
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}no .pre-commit-config.yaml" ]
}

@test "shim: --hook-type=pre-push in the pre-commit slot is generated-broken" {
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-push
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}hook type pre-push" ]
}

@test "shim: no INSTALL_PYTHON line is generated-broken" {
  make_repo
  write_shim "${HK}/pre-commit" "x" pre-commit
  sed -i.bak '/^INSTALL_PYTHON=/d' "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}no INSTALL_PYTHON" ]
}

@test "shim: single-quoted INSTALL_PYTHON with a space is unwrapped" {
  make_repo
  make_py "${TESTDIR}/py dir/python" 0
  write_shim "${HK}/pre-commit" "'${TESTDIR}/py dir/python'" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "generated" ]
}

@test "shim: shlex-quoted apostrophe ('\"'\"') in INSTALL_PYTHON is unwrapped" {
  make_repo
  make_py "${TESTDIR}/it's/python" 0
  write_shim "${HK}/pre-commit" "'${TESTDIR}/it'\"'\"'s/python'" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "generated" ]
}

@test "shim: with two INSTALL_PYTHON lines the last wins" {
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  sed -i.bak "s|^INSTALL_PYTHON=.*|INSTALL_PYTHON=${TESTDIR}/gone/python\n&|" "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "generated" ]
}

@test "shim: INSTALL_PYTHON of \$(touch canary) never runs the command" {
  make_repo
  local canary="${TESTDIR}/canary"
  write_shim "${HK}/pre-commit" "'\$(touch ${canary})'" pre-commit
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [[ "${output}" == "generated-broken${TAB}INSTALL_PYTHON "* ]]
  [ ! -e "${canary}" ]
}

@test "shim: --hook-type=pre-push shim in the pre-push slot of a tracked-source repo is stale" {
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-push" "${TESTDIR}/py/python" pre-push
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

@test "shim: a probe cannot be satisfied by cwd or PYTHONPATH (-I)" {
  # The interpreter must genuinely lack pre_commit (the operator's pyenv
  # python often has it), so take the first real python3 that does.
  local _py="" _cand
  for _cand in "$(command -v python3)" /usr/bin/python3 /usr/local/bin/python3 \
    /opt/homebrew/bin/python3 /home/linuxbrew/.linuxbrew/bin/python3; do
    [[ -x "${_cand}" ]] || continue
    if ! "${_cand}" -I -c 'import pre_commit' >/dev/null 2>&1; then
      _py="${_cand}"
      break
    fi
  done
  [[ -n "${_py}" ]] || skip "no python3 lacking pre_commit"
  make_repo
  write_shim "${HK}/pre-commit" "${_py}" pre-commit
  mkdir -p "${TESTDIR}/probe-cwd" "${TESTDIR}/pp/pre_commit"
  : > "${TESTDIR}/probe-cwd/pre_commit.py"
  : > "${TESTDIR}/pp/pre_commit/__init__.py"
  cd "${TESTDIR}/probe-cwd"
  PYTHONPATH="${TESTDIR}/pp" run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}${_py} cannot import pre_commit" ]
}

@test "shim: relative INSTALL_PYTHON is generated-broken not absolute, never run from cwd or PATH" {
  make_repo
  local canary="${TESTDIR}/canary"
  mkdir -p "${TESTDIR}/cwd" "${TESTDIR}/bin"
  printf '#!/bin/sh\ntouch %s\nexit 0\n' "${canary}" > "${TESTDIR}/cwd/python"
  chmod +x "${TESTDIR}/cwd/python"
  printf '#!/bin/sh\ntouch %s\nexit 0\n' "${canary}" > "${TESTDIR}/bin/python"
  chmod +x "${TESTDIR}/bin/python"
  write_shim "${HK}/pre-commit" "python" pre-commit
  cd "${TESTDIR}/cwd"
  PATH="${TESTDIR}/bin:${PATH}" run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "generated-broken${TAB}INSTALL_PYTHON python not absolute" ]
  [ ! -e "${canary}" ]
}

@test "shim: without _doctor_resolve_timeout the probe resolves timeout from PATH" {
  command -v timeout >/dev/null || skip "no timeout on PATH"
  make_repo
  make_py "${TESTDIR}/py/python" 0
  write_shim "${HK}/pre-commit" "${TESTDIR}/py/python" pre-commit
  unset -f _doctor_resolve_timeout
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 0 ]
  [ "${output}" = "generated" ]
}

@test "resolver: a two-link symlink loop is rc 2 cannot resolve" {
  make_repo
  ln -s "${TESTDIR}/loop-b" "${TESTDIR}/loop-a"
  ln -s "${TESTDIR}/loop-a" "${TESTDIR}/loop-b"
  ln -s "${TESTDIR}/loop-a" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [ "${output}" = "error${TAB}cannot resolve ${HK}/pre-push" ]
}

@test "resolver: a dangling link whose target parent is missing is rc 2" {
  make_repo
  ln -s "${TESTDIR}/no-such-dir/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [ "${output}" = "error${TAB}cannot resolve ${HK}/pre-push" ]
}

@test "resolver: a dangling link whose target parent exists is classified, not rc 2" {
  make_repo
  ln -s "${REPO}/scripts/gone" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "stale" ]
}

# --- symlink content check against the default branch ---------------------

@test "identity: main-only repo resolves its default branch and a clean symlink is match" {
  make_repo
  git -C "${REPO}" branch -m master main
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: main-only repo with a dirty target reports drift naming main" {
  make_repo
  git -C "${REPO}" branch -m master main
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  printf 'echo dirty\n' >> "${REPO}/scripts/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "drift${TAB}scripts/pre-push differs from main${TAB}main${TAB}scripts/pre-push" ]
}

@test "identity: master-only repo clean symlink is match" {
  make_repo
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: both main and master with HEAD on main uses main as default branch (drift)" {
  make_repo
  git -C "${REPO}" branch main
  git -C "${REPO}" checkout -q main
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  printf 'echo dirty\n' >> "${REPO}/scripts/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "drift${TAB}scripts/pre-push differs from main${TAB}main${TAB}scripts/pre-push" ]
}

@test "identity: both main and master with HEAD on a feature branch is an error (default branch ambiguous)" {
  make_repo
  git -C "${REPO}" branch main
  git -C "${REPO}" checkout -q -b feature
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [ "${output}" = "error${TAB}both main and master exist" ]
}

@test "identity: neither main nor master is an error (no default branch)" {
  make_repo
  git -C "${REPO}" checkout -q -b feature
  git -C "${REPO}" update-ref -d refs/heads/master
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 2 ]
  [ "${output}" = "error${TAB}no local main or master branch" ]
}

@test "identity: clean match while HEAD is on a feature branch equal to the default branch" {
  make_repo
  git -C "${REPO}" checkout -q -b feature
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}

@test "identity: dirty target is drift with reason, default branch and candidate fields" {
  make_repo
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  printf 'echo dirty\n' >> "${REPO}/scripts/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 1 ]
  [ "${output}" = "drift${TAB}scripts/pre-push differs from master${TAB}master${TAB}scripts/pre-push" ]
}

@test "identity: candidate staged but never committed on the default branch is drift" {
  make_repo
  git -C "${REPO}" checkout -q -b feature
  printf '#!/bin/sh\necho new\n' > "${REPO}/scripts/pre-commit-hook.sh"
  git -C "${REPO}" add scripts/pre-commit-hook.sh
  git -C "${REPO}" commit -q -m "add candidate on feature only"
  ln -s "${REPO}/scripts/pre-commit-hook.sh" "${HK}/pre-commit"
  run _git_hooks_identity "${REPO}" pre-commit "${HK}/pre-commit"
  [ "${status}" -eq 1 ]
  [ "${output}" = "drift${TAB}scripts/pre-commit-hook.sh is not on master${TAB}master${TAB}scripts/pre-commit-hook.sh" ]
}

@test "identity: unreadable target is an error naming cannot hash" {
  [[ "$(id -u)" -ne 0 ]] || skip "root reads a chmod 000 file"
  make_repo
  ln -s "${REPO}/scripts/pre-push" "${HK}/pre-push"
  chmod 000 "${REPO}/scripts/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  chmod 644 "${REPO}/scripts/pre-push"
  [ "${status}" -eq 2 ]
  [[ "${output}" == "error${TAB}cannot hash "* ]]
}

@test "identity: regular-file copy of a dirty working-tree file is still match" {
  make_repo
  printf 'echo dirty\n' >> "${REPO}/scripts/pre-push"
  cp "${REPO}/scripts/pre-push" "${HK}/pre-push"
  run _git_hooks_identity "${REPO}" pre-push "${HK}/pre-push"
  [ "${status}" -eq 0 ]
  [ "${output}" = "match" ]
}
