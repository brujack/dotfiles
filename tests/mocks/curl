#!/usr/bin/env bash
# Deliberate deviation from real curl: on a successful call with -o, this
# mock BOTH writes MOCK_CURL_STDOUT to the target file AND emits it on
# stdout. Real curl with -o writes only to the file and stays silent on
# stdout. Kept because the callers that never pass -o (whats-new*, workflows.sh:696,
# macos.sh:82) require the stdout emission, and no production caller both
# passes -o and consumes stdout -- verify that still holds before removing it.
ORIG_ARGS="$*"
printf "curl %s\n" "${ORIG_ARGS}" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
outfile=""
has_f=0
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--fail" ]]; then
    has_f=1
    shift
    continue
  fi
  # A short-option cluster (e.g. -fsS, -fLo). Production forms surveyed:
  # -fsS-style clusters, -fLo (developer.sh:105), and --fail (helpers.sh:613).
  # A cluster ending in 'o' takes the next argument as the -o target, same as
  # a bare -o -- otherwise -fLo's target is silently never captured.
  if [[ "$1" =~ ^-[a-zA-Z]+$ ]]; then
    [[ "$1" == *f* ]] && has_f=1
    if [[ "$1" == *o ]]; then
      outfile="${2:-}"
      shift
      [[ $# -gt 0 ]] && shift
      continue
    fi
  fi
  shift
done
# Precedence: MOCK_CURL_EXIT is the pre-existing explicit knob and wins when
# set. MOCK_CURL_HTTP_STATUS applies only when MOCK_CURL_EXIT is unset AND an
# f-bearing form (-f cluster, -fLo, --fail) was passed AND the status value
# is an error (>=400) -- simulating curl -f's fail-on-HTTP-error behavior. A
# caller writing 200 to mean success must not get a failure. The ^[0-9]+$
# gate runs before the arithmetic comparison (shell.md: a non-numeric value
# does not reliably error -- a pure identifier reads as 0, a partly-numeric
# one like "4xx" errors to stderr) so a garbage value gets its own
# fall-through instead of an undefined comparison.
if [[ -n "${MOCK_CURL_EXIT:-}" ]]; then
  mock_exit="${MOCK_CURL_EXIT}"
elif [[ -n "${MOCK_CURL_HTTP_STATUS:-}" ]] && [[ "${has_f}" -eq 1 ]] \
  && [[ "${MOCK_CURL_HTTP_STATUS}" =~ ^[0-9]+$ ]] \
  && [[ "${MOCK_CURL_HTTP_STATUS}" -ge 400 ]]; then
  mock_exit=22
else
  mock_exit=0
fi
# -o's write is deferred until here -- a simulated failure must leave a
# pre-seeded target unchanged, mirroring real curl. When no content is
# supplied, stay a touch (today's behaviour) so the shared mock remains inert
# for every caller that never sets MOCK_CURL_STDOUT.
if [[ "${mock_exit}" -eq 0 ]] && [[ -n "${outfile}" ]]; then
  if [[ -n "${MOCK_CURL_STDOUT:-}" ]]; then
    printf "%s" "${MOCK_CURL_STDOUT}" > "${outfile}"
  else
    touch "${outfile}"
  fi
fi
# URL-pattern dispatch for multi-source scripts; falls back to MOCK_CURL_STDOUT
if [[ "${ORIG_ARGS}" == *"platform.claude.com"* ]] && [[ -n "${MOCK_CURL_PLATFORM_STDOUT:-}" ]]; then
  printf "%s\n" "${MOCK_CURL_PLATFORM_STDOUT}"
elif [[ "${ORIG_ARGS}" == *"githubusercontent.com"* ]] && [[ -n "${MOCK_CURL_SDK_STDOUT:-}" ]]; then
  printf "%s\n" "${MOCK_CURL_SDK_STDOUT}"
elif [[ -n "${MOCK_CURL_STDOUT:-}" ]]; then
  printf "%s\n" "${MOCK_CURL_STDOUT}"
fi
exit "${mock_exit}"
