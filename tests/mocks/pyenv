#!/usr/bin/env bash
# Under env -i MOCK_CALLS_FILE is unset; inside a bats HOME log there, not to
# the shared /tmp file.
if [[ -z "${MOCK_CALLS_FILE:-}" ]] && [[ "${HOME:-}" == */bats-run-* ]]; then
  MOCK_CALLS_FILE="${HOME}/.mock_calls"
fi
printf "pyenv %s\n" "$*" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
# For 'pyenv init -' and 'pyenv virtualenv-init -', output nothing (no-op eval)
if [[ "$1" == "init" ]] || [[ "$1" == "virtualenv-init" ]]; then
  printf ""
  exit 0
fi
# 'pyenv install --list' prints MOCK_PYENV_INSTALL_LIST (newline-separated).
if [[ "$1" == "install" ]] && [[ "$2" == "--list" ]]; then
  [[ -n "${MOCK_PYENV_INSTALL_LIST:-}" ]] && printf "%s\n" "${MOCK_PYENV_INSTALL_LIST}"
  exit 0
fi
# For 'pyenv which python', output MOCK_PYENV_WHICH_STDOUT or real python3 path
if [[ "$1" == "which" ]]; then
  if [[ -n "${MOCK_PYENV_WHICH_STDOUT:-}" ]]; then
    printf "%s\n" "${MOCK_PYENV_WHICH_STDOUT}"
  else
    command -v python3 || printf "/usr/bin/python3\n"
  fi
  exit 0
fi
# Allow per-subcommand exit code override for virtualenv-delete
if [[ "$1" == "virtualenv-delete" ]]; then
  exit "${MOCK_PYENV_VIRTUALENV_DELETE_EXIT:-${MOCK_PYENV_EXIT:-0}}"
fi
# 'pyenv rehash' is a no-op by default -- most suites call it only to assert
# it was invoked. Opt in with MOCK_PYENV_REHASH_LINKS=1 to make it actually
# link every ansible venv bin/ entry into shims/, for the one test that
# needs to tell "the rehash created the shim" apart from "the fixture
# already had it".
if [[ "$1" == "rehash" ]] && [[ -n "${MOCK_PYENV_REHASH_LINKS:-}" ]]; then
  _mock_pyenv_root="${_OVERRIDE_PYENV_ROOT:-${PYENV_ROOT:-}}"
  if [[ -n "${_mock_pyenv_root}" ]] && [[ -d "${_mock_pyenv_root}/versions/ansible/bin" ]]; then
    mkdir -p "${_mock_pyenv_root}/shims"
    for _mock_pyenv_entry in "${_mock_pyenv_root}/versions/ansible/bin"/*; do
      [[ -e "${_mock_pyenv_entry}" ]] || continue
      : > "${_mock_pyenv_root}/shims/$(basename "${_mock_pyenv_entry}")"
    done
  fi
fi
# 'pyenv commands' lists subcommands; tests opt in with MOCK_PYENV_COMMANDS.
if [[ "$1" == "commands" ]]; then
  [[ -n "${MOCK_PYENV_COMMANDS:-}" ]] && printf "%s\n" "${MOCK_PYENV_COMMANDS}"
  exit 0
fi
# 'pyenv install <ver>' models the real effect (an interpreter under
# ${HOME}/.pyenv/versions/<ver>/bin/python) so callers that test -x on it can
# be exercised. It keys on HOME only, never PYENV_ROOT, and refuses to create
# anything outside a bats HOME so a failing test cannot write real state.
if [[ "$1" == "install" ]]; then
  _mock_ver="${!#}"
  if [[ "${_mock_ver}" == -* ]] || [[ "${_mock_ver}" == */* ]]; then
    printf "mock pyenv: invalid version '%s'\n" "${_mock_ver}" >&2
    exit 1
  fi
  _mock_skip=0
  for _mock_arg in "$@"; do
    [[ "${_mock_arg}" == "-s" ]] && _mock_skip=1
  done
  _mock_dir="${HOME}/.pyenv/versions/${_mock_ver}"
  if [[ -f "${HOME}/.mock-pyenv-install-exit" ]]; then
    _mock_code="$(cat "${HOME}/.mock-pyenv-install-exit")"
    if [[ ! "${_mock_code}" =~ ^[0-9]+$ ]] || [[ "${_mock_code}" -gt 255 ]]; then
      printf "mock pyenv: invalid failure file content '%s'\n" "${_mock_code}" >&2
      exit 1
    fi
    exit "${_mock_code}"
  fi
  if [[ -n "${MOCK_PYENV_EXIT:-}" ]]; then
    exit "${MOCK_PYENV_EXIT}"
  fi
  if [[ "${_mock_skip}" -eq 1 ]] && [[ -e "${_mock_dir}" ]]; then
    exit 0
  fi
  if [[ "${HOME}" == */bats-run-* ]]; then
    if [[ ! -e "${_mock_dir}/bin/python" ]]; then
      mkdir -p "${_mock_dir}/bin" || exit 1
      printf '#!/bin/sh\nexit 0\n' > "${_mock_dir}/bin/python" || exit 1
      chmod +x "${_mock_dir}/bin/python" || exit 1
    fi
    exit 0
  fi
  printf "mock pyenv: declined to create interpreter, HOME=%s is not a bats test dir\n" "${HOME}" >&2
  exit 0
fi
exit "${MOCK_PYENV_EXIT:-0}"
