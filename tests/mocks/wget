#!/usr/bin/env bash
printf "wget %s\n" "$*" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
# MOCK_WGET_FAIL_URL: fail only calls whose argv contains this substring,
# leaving a 0-byte -O target (a truncated download). Precedence: a SET
# MOCK_WGET_EXIT (non-empty, "0" included) wins; the knob only adds a failure.
_fail_url=0
[[ -z "${MOCK_WGET_EXIT:-}" ]] && [[ -n "${MOCK_WGET_FAIL_URL:-}" ]] && [[ "$*" == *"${MOCK_WGET_FAIL_URL}"* ]] && _fail_url=1
i=1
while [[ $i -le $# ]]; do
  if [[ "${!i}" == "-O" ]]; then
    j=$((i+1))
    mkdir -p "$(dirname "${!j}")" 2>/dev/null
    # MOCK_WGET_FILE: copy this file to the -O target instead of an empty one,
    # for callers that verify what they downloaded.
    if [[ "${_fail_url}" -eq 1 ]]; then
      : > "${!j}" 2>/dev/null || true
    elif [[ -n "${MOCK_WGET_FILE:-}" ]]; then
      cp "${MOCK_WGET_FILE}" "${!j}" || { printf 'mock wget: cannot copy MOCK_WGET_FILE=%s\n' "${MOCK_WGET_FILE}" >&2; exit 1; }
    else
      touch "${!j}" 2>/dev/null || true
    fi
    break
  fi
  ((i++))
done
[[ "${_fail_url}" -eq 1 ]] && exit 4
exit "${MOCK_WGET_EXIT:-0}"
