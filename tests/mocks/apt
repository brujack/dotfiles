#!/usr/bin/env bash
# Drop APT_CONFFILE_OPTS from the recorded line so call-text assertions stay about the
# command; the options are asserted by the "conffile argv" tests in
# tests/setup_env/linux_ubuntu.bats and the full-upgrade argv test in
# tests/setup_env/linux_shared.bats. ($* must be flattened first:
# ${*//pat/} applies the pattern to each argument separately.)
_all="$*"
printf "apt %s\n" "${_all//-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold /}" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
# MOCK_APT_FAIL_SUBCMD: fail only the named subcommand (first argument that
# does not start with "-"), so one step of a multi-step install can break.
# Only "-o <value>" consumes a following value, so APT_CONFFILE_OPTS never
# reads as one; other value-taking options (e.g. "-t <release>") before the
# verb are not handled.
_skip=0
for _a in "$@"; do
  if [[ "${_skip}" -eq 1 ]]; then _skip=0; continue; fi
  if [[ "${_a}" == "-o" ]]; then _skip=1; continue; fi
  [[ "${_a}" == -* ]] && continue
  if [[ -n "${MOCK_APT_FAIL_SUBCMD:-}" ]] && [[ "${_a}" == "${MOCK_APT_FAIL_SUBCMD}" ]]; then
    exit 100
  fi
  break
done
# MOCK_APT_UPDATE_UNREACHABLE: make `update` behave as real apt does when one source's host
# does not resolve (measured 2026-10-26, apt 3.2.0 on claude): the failed fetch is only a
# W: line and the exit status is 0, unless --error-on=any is given, which makes it E: and
# exits 100.
if [[ -n "${MOCK_APT_UPDATE_UNREACHABLE:-}" ]] && [[ "${_a:-}" == "update" ]]; then
  _sev=W _rc=0
  for _o in "$@"; do [[ "${_o}" == "--error-on=any" ]] && _sev=E _rc=100; done
  printf "%s: Failed to fetch http://unreachable.invalid/ubuntu/dists/noble/InRelease  Could not resolve 'unreachable.invalid'\n" "${_sev}" >&2
  printf '%s: Some index files failed to download. They have been ignored, or old ones used instead.\n' "${_sev}" >&2
  exit "${_rc}"
fi
# MOCK_APT_STDOUT_FILE: emit this file on stdout (captured real apt output), so callers that
# parse apt output see it. The failing-subcommand exit above deliberately skips it.
[[ -n "${MOCK_APT_STDOUT_FILE:-}" ]] && cat "${MOCK_APT_STDOUT_FILE}"
exit "${MOCK_APT_ONLY_EXIT:-${MOCK_APT_EXIT:-0}}"
