#!/usr/bin/env bash
# Mock xargs for testing
# Drop APT_CONFFILE_OPTS from the recorded line so call-text assertions stay about the
# command; the options are asserted by the "conffile argv" tests in
# tests/setup_env/linux_ubuntu.bats and the full-upgrade argv test in
# tests/setup_env/linux_shared.bats. ($* must be flattened first:
# ${*//pat/} applies the pattern to each argument separately.)
_all="$*"
printf "xargs %s\n" "${_all//-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold /}" >> "${MOCK_CALLS_FILE}"
# Drain piped stdin (the filtered package list) and record each token so tests
# can assert which packages reached the install command. Guarded on a non-tty
# stdin so the legacy `xargs -a <file>` form (no pipe) does not block.
if [ ! -t 0 ]; then
  while IFS= read -r _line; do
    [ -n "${_line}" ] && printf "xargs-stdin %s\n" "${_line}" >> "${MOCK_CALLS_FILE}"
  done
fi
# MOCK_XARGS_EXIT stands in for the install xargs ran having failed.
exit "${MOCK_XARGS_EXIT:-0}"
