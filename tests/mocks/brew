#!/usr/bin/env bash
printf "brew %s\n" "$*" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"

case "$1" in
  leaves)
    # shellcheck disable=SC2086 # word-splitting is the point: renders a space-separated list one-per-line, as real brew does
    printf "%s\n" ${MOCK_BREW_LEAVES:-}
    exit 0
    ;;
  list)
    # MOCK_BREW_BROKEN_CASKS (space-separated) models a half-installed cask: real
    # `brew list --cask` still names it, but `brew list --cask --versions` exits 1
    # with "Error: Cask '<name>' is not installed." -- for the whole listing, and
    # for a per-name probe of that cask. MOCK_BREW_LIST_CASK_VERSIONS_EXIT fails
    # only the whole-listing --versions call, leaving per-name probes healthy.
    if [[ "$*" == *"--cask"* && "$*" == *"--versions"* ]]; then
      _mock_names=()
      for _mock_arg in "${@:2}"; do
        [[ "${_mock_arg}" == -* ]] || _mock_names+=("${_mock_arg}")
      done
      # shellcheck disable=SC2086 # word-splitting is the point: the variable is a space-separated list
      for _mock_broken in ${MOCK_BREW_BROKEN_CASKS:-}; do
        if [[ ${#_mock_names[@]} -eq 0 || " ${_mock_names[*]} " == *" ${_mock_broken} "* ]]; then
          printf "Error: Cask '%s' is not installed.\n" "${_mock_broken}" >&2
          exit 1
        fi
      done
      if [[ ${#_mock_names[@]} -gt 0 ]]; then
        printf "%s 1.0\n" "${_mock_names[@]}"
        exit 0
      fi
      if [[ -n "${MOCK_BREW_LIST_CASK_VERSIONS_EXIT:-}" ]]; then
        exit "${MOCK_BREW_LIST_CASK_VERSIONS_EXIT}"
      fi
    fi
    if [[ "$*" == *"--cask"* ]]; then
      # shellcheck disable=SC2086 # word-splitting is the point: renders a space-separated list one-per-line, as real brew does
      printf "%s\n" ${MOCK_BREW_LIST_CASK:-}
    else
      # shellcheck disable=SC2086 # word-splitting is the point: renders a space-separated list one-per-line, as real brew does
      printf "%s\n" ${MOCK_BREW_LIST_FORMULA:-}
    fi
    # MOCK_BREW_LIST_FORMULA_EXIT / MOCK_BREW_LIST_CASK_EXIT fail one listing;
    # MOCK_BREW_LIST_EXIT fails both.
    if [[ "$*" == *"--cask"* ]]; then
      exit "${MOCK_BREW_LIST_CASK_EXIT:-${MOCK_BREW_LIST_EXIT:-0}}"
    fi
    exit "${MOCK_BREW_LIST_FORMULA_EXIT:-${MOCK_BREW_LIST_EXIT:-0}}"
    ;;
  tap)
    if [[ $# -eq 1 ]]; then
      # shellcheck disable=SC2086 # word-splitting is the point: renders a space-separated list one-per-line, as real brew does
      printf "%s\n" ${MOCK_BREW_TAPS:-}
      exit 0
    fi
    exit "${MOCK_BREW_TAP_EXIT:-0}"
    ;;
  install)
    printf "NONINTERACTIVE=%s\n" "${NONINTERACTIVE:-unset}" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
    exit "${MOCK_BREW_INSTALL_EXIT:-0}"
    ;;
  outdated)
    printf "HOMEBREW_NO_AUTO_UPDATE=%s\n" "${HOMEBREW_NO_AUTO_UPDATE:-unset}" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"
    # shellcheck disable=SC2086 # word-splitting is the point: renders a space-separated list one-per-line, as real brew does
    printf "%s\n" ${MOCK_BREW_OUTDATED:-}
    exit "${MOCK_BREW_OUTDATED_EXIT:-0}"
    ;;
  trust)
    if [[ "${MOCK_BREW_TRUST_EXIT:-0}" -ne 0 ]]; then
      printf "Error: mock brew trust failure\n" >&2
    fi
    exit "${MOCK_BREW_TRUST_EXIT:-0}"
    ;;
  update)
    exit "${MOCK_BREW_UPDATE_EXIT:-0}"
    ;;
  upgrade)
    if [[ "$*" == *"--cask"* ]]; then
      exit "${MOCK_BREW_UPGRADE_CASK_EXIT:-${MOCK_BREW_UPGRADE_EXIT:-0}}"
    fi
    exit "${MOCK_BREW_UPGRADE_EXIT:-0}"
    ;;
  --prefix)
    # Prints MOCK_BREW_PREFIX when set, nothing when unset (real brew's prefix is
    # a path; callers must cope with an empty answer).
    [[ -n "${MOCK_BREW_PREFIX:-}" ]] && printf "%s\n" "${MOCK_BREW_PREFIX}"
    exit 0
    ;;
  cleanup)
    exit "${MOCK_BREW_CLEANUP_EXIT:-0}"
    ;;
  *)
    exit "${MOCK_BREW_EXIT:-0}"
    ;;
esac
