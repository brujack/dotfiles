# below is for packer/ansible access as the combo will only use a rsa key
Host 192.168.51.*
  IdentityFile ~/.ssh/id_rsa

# macOS only: the bare names claude and workstation route by location. Linux
# hosts match none of these blocks (the uname test), so they resolve as before.
# Direct is the default; the Cloudflare ProxyJump applies only when
# home-lan-probe is installed and reports this client off the LAN. The probe only
# compares the host key the IP offers, which an impostor can replay (the key is
# public), so it chooses the route and is not the security boundary: the pinned
# HostKeyAlias check with StrictHostKeyChecking yes is, and it refuses an impostor
# rather than prompting. The
# off-LAN blocks come first because `Match host` tests the name after any
# earlier HostName substitution: once a direct block has rewritten claude to
# 192.168.51.17, a later `Match host claude` no longer matches.
# HostName is the verified IP, and HostKeyAlias keeps host-key lookup on the bare
# names already in known_hosts; known_hosts_home ships the bare-name keys (and the
# workstation.home.conecrazy.ca jump hop) for Macs whose known_hosts never held
# them. The *-home aliases do not read it. Match exec runs under "$SHELL -c" and uses
# $HOME, not %d (which ignores HOME).
Match host claude exec "[ \"$(uname -s)\" = Darwin ] && test -x $HOME/.local/bin/home-lan-probe && ! $HOME/.local/bin/home-lan-probe 192.168.51.17 SHA256:ng/HWNyh2AZ1gm9iMy1Vd59+VFq8Sx00SJ6Uh3a7qfY"
  ProxyJump home-secure.conecrazy.ca,workstation.home.conecrazy.ca
Match host workstation exec "[ \"$(uname -s)\" = Darwin ] && test -x $HOME/.local/bin/home-lan-probe && ! $HOME/.local/bin/home-lan-probe 192.168.51.12 SHA256:ZVFVKdcncNrEMmWrb/4gDdgn6NP0lgpQm1vxyFe1y/o"
  ProxyJump home-secure.conecrazy.ca
Match host claude exec "[ \"$(uname -s)\" = Darwin ]"
  HostName 192.168.51.17
  HostKeyAlias claude
  User bruce
  IdentityFile ~/.ssh/home
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_home
  StrictHostKeyChecking yes
Match host workstation exec "[ \"$(uname -s)\" = Darwin ]"
  HostName 192.168.51.12
  HostKeyAlias workstation
  User bruce
  IdentityFile ~/.ssh/home
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_home
  StrictHostKeyChecking yes
# The claude chain jumps through this name, so it needs the tracked key too.
Match host workstation.home.conecrazy.ca exec "[ \"$(uname -s)\" = Darwin ]"
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_home

Host *.home.conecrazy.ca
  User bruce
  IdentityFile ~/.ssh/home

# The Cloudflare tunnel is only used from Apple-silicon macs, so the Homebrew
# path is deliberate; it also resolves for ssh spawned without a login PATH.
Host home-secure.conecrazy.ca
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  # Cloudflare reaps an idle proxied connection; keep it busy while a remote
  # session sits waiting for input.
  ServerAliveInterval 30

# Off-network routes: Cloudflare -> bastion -> workstation (the only hop
# pfSense allows out of the bastion network) -> the trusted network. Host
# patterns match the alias, not HostName, so *.home.conecrazy.ca's User and
# IdentityFile are repeated in the *-home catch-all below, which also gives
# them to any future alias ending in -home. The workstation hop asks for a
# password; with ProxyJump it is typed into this client and the bastion only
# forwards the encrypted stream. Inside the house, use the *.home.conecrazy.ca
# names.
Host workstation-home
  HostName workstation.home.conecrazy.ca
  ProxyJump home-secure.conecrazy.ca

Host claude-home
  HostName claude.home.conecrazy.ca
  ProxyJump home-secure.conecrazy.ca,workstation.home.conecrazy.ca

Host *-home
  User bruce
  IdentityFile ~/.ssh/home
  ServerAliveInterval 30
