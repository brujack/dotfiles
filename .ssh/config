Host *.amazonaws.com
  User root
  IdentityFile ~/.ssh/id_rsa

# below is for packer/ansible access as the combo will only use a rsa key
Host 3.*.*.*
  IdentityFile ~/.ssh/id_rsa

# below is for packer/ansible access as the combo will only use a rsa key
Host 13.*.*.*
  IdentityFile ~/.ssh/id_rsa

# below is for packer/ansible access as the combo will only use a rsa key
Host 18.*.*.*
  IdentityFile ~/.ssh/id_rsa

Host github.com
  HostName github.com
  IdentityFile ~/.ssh/github
  ServerAliveInterval 60
  ServerAliveCountMax 10
  # Keep SSH connection alive during long pre-push hooks (molecule test matrix ~10min)

Host gitlab.com
  HostName gitlab.com
  Preferredauthentications publickey
  User brujack2
  IdentityFile ~/.ssh/gitlab

# below is for packer/ansible access as the combo will only use a rsa key
Host 192.168.51.*
  IdentityFile ~/.ssh/id_rsa

Host *.home.conecrazy.ca
  User bruce
  IdentityFile ~/.ssh/home

Host home-secure.conecrazy.ca
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  # Cloudflare reaps an idle proxied connection; keep it busy while a remote
  # session sits waiting for input.
  ServerAliveInterval 30

# Off-network routes: Cloudflare -> bastion -> workstation (the only hop
# pfSense allows out of the bastion network) -> the trusted network. Host
# patterns match the alias, not HostName, so *.home.conecrazy.ca's User and
# IdentityFile are repeated in the *-home catch-all below, which also gives
# them to any future alias ending in -home. The workstation hop asks for a
# password; with ProxyJump it is typed into this client and the bastion only
# forwards the encrypted stream. Inside the house, use the *.home.conecrazy.ca
# names.
Host workstation-home workstation-home-tmux
  HostName workstation.home.conecrazy.ca
  ProxyJump home-secure.conecrazy.ca

Host claude-home claude-home-tmux
  HostName claude.home.conecrazy.ca
  ProxyJump home-secure.conecrazy.ca,workstation.home.conecrazy.ca

Host *-home *-home-tmux
  User bruce
  IdentityFile ~/.ssh/home
  ServerAliveInterval 30

# RemoteCommand is refused alongside a command-line command, so it lives on
# separate -tmux aliases and the plain ones stay usable for scp and one-off
# commands.
Host *-home-tmux
  RequestTTY yes
  RemoteCommand tmux attach-session || tmux new-session
