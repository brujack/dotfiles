.DS_Store
.firecrawl/
node_modules/
package-lock.json
.vagrant
.dccache

# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md

config/local.sh

# Version manager files (machine-local)
.ruby-version
.python-version
.node-version

# Pester coverage output
powershell/coverage.xml

# bash/kcov coverage output
coverage/

# Python tooling artifacts, from repo-structure.md's canonical template, which
# lists exactly these four.
#
# `.coverage` is the only one that was genuinely untracked here -- a `coverage
# run` during review left one in the worktree, one `git add -A` from being
# committed. `__pycache__/` and `*.pyc` were already covered by
# `.gitignore_global`. They are repeated here anyway because a global
# excludesFile is per-machine and buys nothing on CI or a fresh clone.
#
# `.hypothesis/` is deliberately ABSENT. Hypothesis writes
# `.hypothesis/.gitignore` containing `*`, so the directory ignores itself and
# needs no entry anywhere -- measured in 95b67ea2 on this branch, which removed
# exactly this line from .gitignore_global for exactly this reason. Do not
# re-add it; if a future Hypothesis stops self-ignoring, say so here.
__pycache__/
*.pyc
.coverage
htmlcov/

# .claude/ and .cursor/ have moved to ~/git-repos/personal/ai-config
# These entries prevent leftover on-disk directories from being tracked
.claude/*
!.claude/settings.json
# ADR-0014: canonical memory + retrospective layout (unignore tracked dirs)
!.claude/memory/
!.claude/retrospectives/
.claude/memory/*.jsonl
.claude/memory/.lock
.cursor/
.claude/loop-log/*.jsonl
.claude/triage-log/*.jsonl

# Interrupted check-versions --update leftovers (lib/ cannot trap)
lib/.constants.*
lib/.refresh-pins.*
