# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md

config/local.sh

# Version manager files (machine-local)
.ruby-version
.python-version
.node-version

# Pester coverage output
powershell/coverage.xml

# bash/kcov coverage output
coverage/

# .claude/ and .cursor/ have moved to ~/git-repos/personal/ai-config
# These entries prevent leftover on-disk directories from being tracked
.claude/*
!.claude/settings.json
# triage_log.py is vendored per-repo by bug-fix-cycle, not symlinked from
# ai-config like the rest of ~/.claude — so it has to be tracked here despite
# the rule above. Its output (.claude/triage-log/) stays ignored.
#
# All three lines are load-bearing and the order matters. git cannot re-include
# a file inside an excluded directory, so the directory must be un-excluded
# first — but un-excluding it alone re-admits every file under it at any depth,
# which makes the third line inert and leaves a stray .env or a future synced
# script eligible for `git add -A`. The middle line re-excludes the contents so
# the allow-path is exactly one file wide, matching the deny-path it carves.
!.claude/scripts/
.claude/scripts/*
!.claude/scripts/triage_log.py
# ADR-0014: canonical memory + retrospective layout (unignore tracked dirs)
!.claude/memory/
!.claude/retrospectives/
.claude/memory/*.jsonl
.claude/memory/.lock
.cursor/
.claude/loop-log/*.jsonl
.claude/triage-log/*.jsonl
