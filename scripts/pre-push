#!/usr/bin/env bash
# Pre-push hook: runs full test suite locally before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
fi

needs_test=0
refuse_paths=""
# shellcheck disable=SC2034 # git's pre-push protocol supplies 4 whitespace-separated
# fields per stdin line; local_ref must be named to consume the line
# positionally even though it is never read. remote_ref IS read, by the
# direct-to-master guard below.
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" == "0000000000000000000000000000000000000000" ]] && continue

    if [[ "${remote_sha}" == "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    # Fail closed (ADR-0017): trigger unless EVERY changed path is provably
    # inert. grep -qv succeeds when any path does NOT match the inert set, so
    # one unrecognized path is enough to run the suite. Do not "fix" this back
    # to an allowlist (-qE of trigger patterns) — that shape missed four real
    # file classes in one session; see the ADR for the full history.
    #
    # `make lint`'s SHELL_FILES walks the whole repo recursively, so a .sh
    # file under docs/ or .github/ is still linted by `make test` even though
    # those directories are otherwise mostly inert — the inert set below only
    # excuses .md files and .yml/.yaml files under .github/, not every path
    # under those directories.
    #
    # git diff itself can fail (e.g. remote_sha names an object this checkout
    # doesn't have) — that must also fail closed, not silently read as "no
    # changes". The assignment is wrapped in an if-condition so a non-zero
    # exit doesn't trip this script's own `set -e`.
    if changed="$(git diff --name-only "${range}" 2>/dev/null)"; then
        diff_rc=0
    else
        diff_rc=$?
    fi

    if [[ ${diff_rc} -ne 0 ]]; then
        needs_test=1
    elif [[ -n "${changed}" ]] && printf '%s\n' "${changed}" | grep -qE '^tests/'; then
        # Anything under tests/ always triggers, ahead of the inert check.
        # `\.md$` below is unanchored on the left, so without this a future
        # .md fixture under tests/ would be read by the suite and skipped by
        # the gate — the same shape as the bug this whole hook exists to fix.
        needs_test=1
    elif [[ -n "${changed}" ]] && printf '%s\n' "${changed}" | grep -qvE '\.md$|^\.github/.*\.ya?ml$|^LICENSE$'; then
        needs_test=1
    fi

    # Direct-to-master guard. ci.yml triggers on pull_request only, so a code
    # change pushed straight to master is validated by nothing -- measured
    # 2026-09-11, five such pushes in one session. Accumulate rather than
    # exiting here: the loop must drain every ref line (a single push can send
    # a real branch plus a deletion), so the verdict is read after the loop.
    #
    # Scope is the executable class the operator chose, deliberately narrower
    # than sdlc-branch-guard's is_safe_file: .zshrc, starship.toml,
    # .shellcheckrc and .github/workflows/*.yml stay pushable direct, none
    # having ever been pushed that way. tests/mocks/* is extensionless shell
    # and is NOT covered -- a known gap, recorded rather than silently closed.
    if [[ "${remote_ref}" == "refs/heads/master" && -n "${changed}" ]]; then
        _offenders="$(printf '%s\n' "${changed}" \
            | grep -E '\.(sh|bash|bats|zsh)$|(^|/)Makefile$|^scripts/(pre-push|commit-msg)$' || true)"
        [[ -n "${_offenders}" ]] && refuse_paths="${refuse_paths}${_offenders}"$'\n'
    fi
done

if [[ -n "${refuse_paths}" ]]; then
    printf 'pre-push: refusing a direct push to master carrying executable files.\n' >&2
    printf '%s\n' "${refuse_paths}" | grep -v '^$' | sed 's/^/  /' >&2
    printf 'ci.yml runs on pull_request only, so these would reach master with no CI.\n' >&2
    printf 'Use a branch and a PR: git push -u origin HEAD:feat/<name> && gh pr create\n' >&2
    exit 1
fi

[[ "${needs_test}" -eq 0 ]] && exit 0

# Git exports GIT_DIR into this hook's environment when the push originates
# from a worktree (git-workflow.md's measured table); every suite below that
# builds a git fixture would inherit it. Must stay below the range resolution
# above, which legitimately wants the git environment.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

printf "Running tests locally (pre-push)...\n"
make -C "${REPO_ROOT}" test
