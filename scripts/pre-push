#!/usr/bin/env -S bash -p
# Pre-push hook: runs full test suite locally before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

# >>> push-content-gate wiring
# >>> _pcg_fetch
_pcg_fetch() { # <api path>; prints the raw file. curl reads no user-writable configuration; the token comes from gh's own store.
  local tok ca
  tok="$(gh auth token 2>/dev/null)" || return 1
  case "${tok}" in '' | *[!A-Za-z0-9_]*) return 1 ;; esac
  for ca in /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem ''; do [[ -r "${ca}" ]] && break; done
  [[ -n "${ca}" ]] || return 1
  printf 'header = "Authorization: Bearer %s"\n' "${tok}" \
    | env -i /usr/bin/curl -q --silent --show-error --fail --proto '=https' --noproxy '*' \
        --cacert "${ca}" --max-time 20 -K - -H 'Accept: application/vnd.github.raw' \
        "https://api.github.com/${1}"
}
# <<< _pcg_fetch
_pcg_refs="$(cat)" || { printf 'pre-push: cannot read the pushed refs\n' >&2; exit 1; }
if printf '%s\n' "${_pcg_refs}" | awk '$3 == "refs/heads/master" || $3 == "refs/heads/main" { f = 1 } END { exit !f }'; then
  # shellcheck disable=SC1090 # the library is fetched at runtime; there is no file to follow
  if _pcg_src="$(_pcg_fetch 'repos/brujack/ai-config/contents/.claude/hooks/push-content-gate.sh?ref=master')" \
    && source <(printf '%s\n' "${_pcg_src}") \
    && declare -F push_content_gate_refs >/dev/null; then
    push_content_gate_refs "${_pcg_refs}" "${2}" || exit 1
  else
    printf 'pre-push: cannot load the push-content gate from GitHub (brujack/ai-config master); refusing a push to master/main.\n' >&2
    printf 'Check the network and gh auth status, then retry.\n' >&2
    exit 1
  fi
fi
# <<< push-content-gate wiring

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
fi

# Default-deny: a path is inert only if it is a .md outside the root tests/,
# or the root LICENSE, AND its blob does not start with #! (make lint selects
# shell files by first line, whatever their name). Call only in a conditional:
# this hook runs under set -e.
_path_is_inert() {
    local _path="${1}" _sha="${2}" _head _entry _mode
    case "${_path}" in
        tests/*) return 1 ;;
        LICENSE | *.md) ;;
        *) return 1 ;;
    esac
    # Decide from the tree entry at the pushed commit, never from the object:
    # an object can be absent from this repo while the path is present (a
    # gitlink to a commit never fetched). --literal-pathspecs stops [ * ? in a
    # name acting as globs. A failing ls-tree is not inert; that branch is not
    # expected to be reachable once the diff has succeeded, and it fails closed.
    _entry="$(git --literal-pathspecs ls-tree "${_sha}" -- "${_path}")" || return 1
    # No entry: absent at the tip (deleted), so it never lands.
    [[ -z "${_entry}" ]] && return 0
    _mode="${_entry%% *}"
    # Only regular files; a symlink (120000) or gitlink (160000) is not inert.
    [[ "${_mode}" == "100644" || "${_mode}" == "100755" ]] || return 1
    # An unreadable blob is not inert. The read below runs in a process
    # substitution, whose status nothing sees, so a missing object would leave
    # _head empty and read as inert: check the object exists first.
    git cat-file -e "${_sha}:${_path}" 2>/dev/null || return 1
    # Process substitution rather than a pipe: a pipe would be harmless here
    # (no pipefail), and this stays quiet about SIGPIPE if pipefail is ever
    # added. Only head's own failure is visible through the || below.
    _head="$(head -c 2 < <(git cat-file blob "${_sha}:${_path}"))" || return 1
    [[ "${_head}" != '#!' ]]
}

# Run the checker blob from <sha> against <sha>. Both pipeline stages must
# succeed: a failed git show feeds python an empty program, which exits 0.
_budget_check_in_pipe() {
    local _sha="${1}"
    set -o pipefail
    git show "${_sha}:scripts/claude_md_budget.py" | python3 -I - "${_sha}"
}

# Subshell so pipefail does not leak into the rest of the hook.
_budget_ok() {
    ( _budget_check_in_pipe "${1}" ) >&2
}

needs_test=0
unresolved_refs=""
budget_refs=""
pushed_refs=""
if [[ -n "${_pcg_refs}" ]]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ "${local_sha}" == "0000000000000000000000000000000000000000" ]] && continue
        pushed_refs="${pushed_refs}${local_ref} ${local_sha} ${remote_ref}"$'\n'

        if [[ "${remote_sha}" == "0000000000000000000000000000000000000000" ]]; then
            # No shared history with origin/master (first push to an empty remote):
            # diff from the empty tree so the root commit's own files are included;
            # a root..sha range would leave them out and fail open.
            if ! base="$(git merge-base "${local_sha}" origin/master 2>/dev/null)"; then
                base="$(git hash-object -t tree /dev/null)"
            fi
            range="${base}..${local_sha}"
        else
            range="${remote_sha}..${local_sha}"
        fi

        # CLAUDE.md byte budget (ADR-0047). The checker is taken from the pushed
        # commit, not the working tree, so a stale or edited local copy cannot
        # change the verdict. A commit with no checker predates the gate: skip.
        # Any failure (ls-tree, show, or the checker itself) refuses the ref;
        # accumulate rather than exit so the loop still drains every ref line.
        if ! _budget_listing="$(git ls-tree "${local_sha}" -- scripts/claude_md_budget.py)"; then
            budget_refs="${budget_refs}${local_ref}"$'\n'
        elif [[ -n "${_budget_listing}" ]]; then
            if ! _budget_ok "${local_sha}"; then
                budget_refs="${budget_refs}${local_ref}"$'\n'
            fi
        fi

        # Fail closed (ADR-0017): trigger unless EVERY changed path is provably
        # inert, as _path_is_inert defines it. Default-deny: a path the predicate
        # does not recognise runs the suite. --no-renames lists both sides of a
        # rename, so x.sh -> x.md cannot hide the .sh; core.quotePath=false keeps
        # non-ASCII names unquoted so the predicate sees the real path.
        #
        # git diff itself can fail (e.g. remote_sha names an object this checkout
        # doesn't have) — that must also fail closed, not silently read as "no
        # changes". The assignment is wrapped in an if-condition so a non-zero
        # exit doesn't trip this script's own `set -e`.
        if changed="$(git -c core.quotePath=false diff --no-renames --name-only "${range}" 2>/dev/null)"; then
            diff_rc=0
        else
            diff_rc=$?
        fi

        if [[ ${diff_rc} -ne 0 ]]; then
            needs_test=1
        else
            while IFS= read -r _p; do
                [[ -z "${_p}" ]] && continue
                if ! _path_is_inert "${_p}" "${local_sha}"; then
                    needs_test=1
                fi
            done <<< "${changed}"
        fi

        # An unresolvable range on a master push is refused: the shared gate
        # (wiring above) cannot judge paths it cannot list. Accumulate rather than
        # exiting so the loop still drains every ref line.
        if [[ "${remote_ref}" == "refs/heads/master" && ${diff_rc} -ne 0 ]]; then
            unresolved_refs="${unresolved_refs}${remote_ref}"$'\n'
        fi
    done <<< "${_pcg_refs}"
fi

if [[ -n "${unresolved_refs}" ]]; then
    printf 'pre-push: cannot resolve the diff range for a push to:\n' >&2
    printf '%s\n' "${unresolved_refs}" | grep -v '^$' | sed 's/^/  /' >&2
    printf 'Run git fetch and retry the push.\n' >&2
    exit 1
fi

if [[ -n "${budget_refs}" ]]; then
    printf 'pre-push: CLAUDE.md budget check failed for:\n' >&2
    printf '%s\n' "${budget_refs}" | grep -v '^$' | sed 's/^/  /' >&2
    printf 'Any message from git or the checker is above.\n' >&2
    exit 1
fi

[[ "${needs_test}" -eq 0 ]] && exit 0

# The suite below tests REPO_ROOT's working tree, so a green run says nothing
# about a pushed ref unless that ref is at the tree's HEAD. HEAD is read from
# that tree with the git environment stripped (an exported GIT_DIR from a
# worktree push would otherwise name a different HEAD than the one make tests).
# Each git read sits in a conditional: this hook runs under set -e. A failed
# read or peel leaves the value empty and the ref is refused (fail closed).
if ! tree_head="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
    git -C "${REPO_ROOT}" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)"; then
    tree_head=""
fi
# Name the remote only when it is a configured remote name: git passes $1 as a
# URL for a URL push, and a URL can carry a token that must never be printed.
remote_name="<remote>"
# Exact whole-line comparison, never a pattern match; a $1 holding a newline
# cannot be a remote name, so it is never printed.
if [[ -n "${1:-}" && "${1}" != *$'\n'* ]]; then
    while IFS= read -r _name; do
        if [[ "${_name}" == "${1}" ]]; then
            remote_name="${1}"
            break
        fi
    done < <(git remote 2>/dev/null)
fi
wrong_tree_lines=""
remedy_lines=""
while read -r _ref _sha _remote_ref; do
    [[ -z "${_ref}" ]] && continue
    if ! _peeled="$(git rev-parse --verify --quiet "${_sha}^{commit}" 2>/dev/null)"; then
        _peeled=""
    fi
    if [[ -z "${_peeled}" || -z "${tree_head}" || "${_peeled}" != "${tree_head}" ]]; then
        _ref_at="unresolved"
        [[ -n "${_peeled}" ]] && _ref_at="${_peeled:0:7}"
        _tree_at="unresolved"
        [[ -n "${tree_head}" ]] && _tree_at="${tree_head:0:7}"
        # A non-refs/ local_ref (HEAD~1, a bare sha) means nothing in another
        # checkout, so the full sha is the source there.
        _src="${_ref}"
        [[ "${_ref}" == refs/* ]] || _src="${_sha}"
        remedy_lines="${remedy_lines}  git push ${remote_name} ${_src}:${_remote_ref}"$'\n'
        wrong_tree_lines="${wrong_tree_lines}  ${_src} is at ${_ref_at}; this checkout (${REPO_ROOT}) is at ${_tree_at}."$'\n'
    fi
done <<< "${pushed_refs}"
if [[ -n "${wrong_tree_lines}" ]]; then
    printf "pre-push: the suite tests this checkout's working tree, not the pushed commit.\n" >&2
    printf '%s' "${wrong_tree_lines}" >&2
    printf 'Push each ref from a checkout whose HEAD is that commit:\n' >&2
    printf '%s' "${remedy_lines}" >&2
    printf 'Re-add any flags the original push used (-u, --force-with-lease).\n' >&2
    exit 1
fi

# git against REPO_ROOT with the git environment stripped: `git -C` does not
# override an exported GIT_DIR, so a worktree push would otherwise read the
# wrong repository's index.
_git_stripped() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
        git -C "${REPO_ROOT}" "$@"
}

# Messages for the temporary-checkout path: <count> <sha7> <path>, <sha7> <path>.
_say_dirty() {
    printf 'pre-push: working tree has %s uncommitted or untracked path(s); testing committed %s in clean checkout %s.\n' \
        "${1}" "${2}" "${3}" >&2
}
_say_unreadable() {
    printf 'pre-push: could not read the working-tree status; testing committed %s in clean checkout %s.\n' \
        "${1}" "${2}" >&2
}
_say_no_checkout() {
    printf 'pre-push: could not create a temporary checkout of %s; push refused.\n' "${1}" >&2
}
_say_suite_failed() {
    printf 'pre-push: suite failed against committed %s (clean checkout %s, now removed); uncommitted changes were not tested.\n' \
        "${1}" "${2}" >&2
}

# The suite tests a tree, and uncommitted edits in REPO_ROOT would change the
# verdict about the pushed commit. A dirty tree (tracked or untracked, not
# ignored) or an unreadable status therefore tests the commit in a clean
# temporary checkout instead. The read sits in a conditional: set -e.
_status_ok=0
if _status="$(_git_stripped --no-optional-locks status --porcelain --untracked-files=all 2>/dev/null)"; then
    _status_ok=1
fi

# Git exports GIT_DIR into this hook's environment when the push originates
# from a worktree (git-workflow.md's measured table); every suite below that
# builds a git fixture would inherit it. Must stay below the range resolution
# above, which legitimately wants the git environment.
if [[ ${_status_ok} -eq 1 && -z "${_status}" ]]; then
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

    printf "Running tests locally (pre-push)...\n"
    make -C "${REPO_ROOT}" test
    exit $?
fi

# Dirty or unreadable: a subshell so its EXIT trap fires on every way out of
# this step. The trap is installed only once the temp root exists, so cleanup
# never receives an empty path, and it removes only what this run created.
# TERM is trapped in the hook's own shell so bash waits for the cleanup
# subshell before exiting 143; untrapped, the hook exits at once while the
# checkout is still being removed. INT needs no trap: bash already waits for a
# foreground child on SIGINT. A TERM sent only to the hook's own pid (not its
# process group) therefore waits for the running suite to finish before the
# hook exits. Dirty branch only; the clean path creates nothing to clean up.
trap 'exit 143' TERM
_tmp_status=0
(
    _tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")" || { _say_no_checkout "${tree_head:0:7}"; exit 1; }
    [[ -n "${_tmp_root}" ]] || { _say_no_checkout "${tree_head:0:7}"; exit 1; }
    _tree="${_tmp_root}/pre-push-${tree_head:0:7}"
    # Single-quoted: expands when the trap fires, so a quote in TMPDIR cannot
    # break the parse. The second remove clears a registration left when the
    # first failed (a locked entry whose directory is gone is never pruned).
    # Each command ends `|| :` because errexit is live inside an EXIT trap: a
    # failed cleanup step would otherwise abort the rest of the cleanup and
    # replace the suite's exit status.
    trap '_git_stripped worktree remove -f -f "${_tree}" 2>/dev/null || :; rm -rf "${_tmp_root}" || :; _git_stripped worktree remove -f -f "${_tree}" 2>/dev/null || :' EXIT
    _git_stripped worktree add --quiet --detach --lock \
        --reason "pre-push pid $$ testing ${tree_head:0:7}" "${_tree}" "${tree_head}" || { _say_no_checkout "${tree_head:0:7}"; exit 1; }
    if [[ ${_status_ok} -eq 1 ]]; then
        _say_dirty "$(printf '%s\n' "${_status}" | awk 'END { print NR }')" "${tree_head:0:7}" "${_tree}"
    else
        _say_unreadable "${tree_head:0:7}" "${_tree}"
    fi
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

    printf "Running tests locally (pre-push)...\n"
    if make -C "${_tree}" test; then
        exit 0
    else
        _rc=$?
        _say_suite_failed "${tree_head:0:7}" "${_tree}"
        exit "${_rc}"
    fi
) || _tmp_status=$?
exit "${_tmp_status}"
