#!/usr/bin/env bash
# Pre-push hook: runs full test suite locally before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
fi

needs_test=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" == "0000000000000000000000000000000000000000" ]] && continue

    if [[ "${remote_sha}" == "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    # Fail closed (ADR-0017): trigger unless EVERY changed path is provably
    # inert. grep -qv succeeds when any path does NOT match the inert set, so
    # one unrecognized path is enough to run the suite. Do not "fix" this back
    # to an allowlist (-qE of trigger patterns) — that shape missed four real
    # file classes in one session; see the ADR for the full history.
    if git diff --name-only "${range}" | grep -qvE '\.md$|^docs/|^\.github/|^LICENSE$|^CHANGELOG'; then
        needs_test=1
    fi
done

[[ "${needs_test}" -eq 0 ]] && exit 0

# Git exports GIT_DIR into this hook's environment when the push originates
# from a worktree (git-workflow.md's measured table); every suite below that
# builds a git fixture would inherit it. Must stay below the range resolution
# above, which legitimately wants the git environment.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

printf "Running tests locally (pre-push)...\n"
make -C "${REPO_ROOT}" test
